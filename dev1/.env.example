# ==========================================================================
# MedExtract AI - Variables d'environnement
# Copier ce fichier en .env :  cp .env.example .env
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_USER=medextract
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=medextract

# --- RabbitMQ ---
RABBITMQ_USER=medextract
RABBITMQ_PASSWORD=change_me_in_production

# --- JWT (PARTAGE par tous les services pour verifier les tokens) ---
JWT_SECRET_KEY=super-secret-key-change-me-please-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- URLs internes des microservices (reseau docker) ---
AUTH_SERVICE_URL=http://auth-service:8081
DOCUMENT_SERVICE_URL=http://document-service:8082
OCR_SERVICE_URL=http://ocr-service:8083
AI_SERVICE_URL=http://ai-service:8084
CHATBOT_SERVICE_URL=http://chatbot-service:8085
REPORTING_SERVICE_URL=http://reporting-service:8086

# --- RabbitMQ URL ---
RABBITMQ_URL=amqp://medextract:change_me_in_production@rabbitmq:5672/

# --- LLM (Chatbot - DEV 3) ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# --- Upload (DEV 2) ---
MAX_UPLOAD_MB=20
UPLOAD_DIR=/app/uploads
